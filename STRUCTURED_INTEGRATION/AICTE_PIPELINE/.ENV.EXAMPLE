# ── DATABASE (canonical structured layer) ──────────────────────────────
# Use a dedicated port so this pipeline can run concurrently with the AICTE_DB
# docker-compose stack, which already uses MySQL 3307, Postgres 5433, Mongo 27017.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=aicte_canonical
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ── LIVE SOURCE SYSTEMS (real AICTE_DB databases) ───────────────────────
SOURCE_MYSQL_URI=mysql+mysqlconnector://aicte_app:aicte_pass@localhost:3307/aicte_institutes
SOURCE_POSTGRES_COURSES_URI=postgresql+psycopg://postgres:postgres@localhost:5433/courses_db
SOURCE_POSTGRES_FACULTY_URI=postgresql+psycopg://postgres:postgres@localhost:5433/faculty_db
SOURCE_MONGO_URI=mongodb://localhost:27017
SOURCE_MONGO_DB=aicte_scholarships
SOURCE_MONGO_COLLECTION=scholarships

# ── EMBEDDINGS (local Ollama, shared with the document-warehouse arm so ──
# ── both sides live in the same vector space -- see repo README) ────────
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ── LLM (local, for hybrid retrieval / answer synthesis -- no cloud API) ─
LLM_MODEL=qwen3:8b

# ── SECURITY ──────────────────────────────────────────────────────────
# Shared secret for the X-API-Key header AUTH.py checks on every endpoint.
# Generate a real one before deploying anywhere but localhost, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme_generate_a_real_key

# ── PIPELINE ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
USE_SAMPLE_DATA=false
