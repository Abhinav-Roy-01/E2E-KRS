# ── DATABASE (document-warehouse arm) ───────────────────────────────────
DATABASE_URL=postgresql+psycopg://ekrs:ekrs_dev_password@localhost:5432/ekrs
DATABASE_URL_PSYCOPG=dbname=ekrs user=ekrs password=ekrs_dev_password host=localhost port=5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ekrs
POSTGRES_USER=ekrs
POSTGRES_PASSWORD=ekrs_dev_password

REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ekrs_minio
MINIO_SECRET_KEY=ekrs_minio_dev_password
MINIO_BUCKET=ekrs-documents

# ── LOCAL MODELS (Ollama) -- standardized across BOTH arms, see ─────────
# STRUCTURED_INTEGRATION/README.MD "Resolved: local LLM everywhere"
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
LLM_MODEL=qwen3:8b

# ── SECURITY ──────────────────────────────────────────────────────────
# Shared secret for the X-API-Key header AUTH.py checks on every endpoint.
# Generate a real one before deploying anywhere but localhost, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme_generate_a_real_key
