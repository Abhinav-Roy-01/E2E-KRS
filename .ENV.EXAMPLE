# ── DATABASE (document-warehouse arm) ───────────────────────────────────
DATABASE_URL=postgresql+psycopg://ekrs:ekrs_dev_password@localhost:5432/ekrs
DATABASE_URL_PSYCOPG=dbname=ekrs user=ekrs password=ekrs_dev_password host=localhost port=5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ekrs
POSTGRES_USER=ekrs
POSTGRES_PASSWORD=ekrs_dev_password

REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ekrs_minio
MINIO_SECRET_KEY=ekrs_minio_dev_password
MINIO_BUCKET=ekrs-documents

# ── LOCAL MODELS (Ollama) -- standardized across BOTH arms, see ─────────
# STRUCTURED_INTEGRATION/README.MD "Resolved: local LLM everywhere"
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
LLM_MODEL=qwen3:8b

# ── SECURITY ──────────────────────────────────────────────────────────
# No shared API_KEY anymore -- every caller authenticates as a real user
# (name, role, department) via a key hashed and stored in the `users`
# table. Create the first one with:
#   python SECURITY_SERVICE/APP/CREATE_USER.py --name "Your Name" \
#     --email you@example.gov.in --role admin --department Engineering
# The command prints a raw API key ONCE -- save it, it's not recoverable
# (only its hash is stored). Use it as the X-API-Key header on every request.
